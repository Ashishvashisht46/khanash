{
  "name": "dental-rcm-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node ../node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "db:migrate": "node ../node_modules/tsx/dist/cli.mjs src/db/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
